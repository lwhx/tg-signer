# Copy this file to .env and replace the auth code with a random value.
# Example: openssl rand -hex 24
TG_SIGNER_GUI_AUTHCODE=REPLACE_WITH_A_LONG_RANDOM_CODE

# Optional: separate persistent NiceGUI cookie signing secret.
# When unset, Compose uses the strong TG_SIGNER_GUI_AUTHCODE as a stable key.
# Generate a DIFFERENT secret with: openssl rand -hex 32
# TG_SIGNER_GUI_STORAGE_SECRET=

# Host WebUI binding: localhost only by default. Use a protected reverse proxy.
WEBUI_BIND_IP=127.0.0.1
# Change to 8999 to match the original dashboard's host-side port.
WEBUI_PORT=8080

# Change the timezone if desired.
TZ=Asia/Shanghai

# Optional Telegram SOCKS5/HTTP proxy, e.g. socks5://172.17.0.1:7890
TG_PROXY=

# Used only when the optional automation profile is enabled.
# The corresponding config must exist in data/.signer/automations/<task>/config.json.
TG_SIGNER_AUTOMATION_TASK=example_task
