{
  "rules": [
    {
      "id": "archive_multiple_sources",
      "enabled": true,
      "triggers": [
        {
          "type": "message",
          "params": {
            "chat_ids": [
              "@SOURCE_CHANNEL_A",
              "@SOURCE_GROUP_B"
            ]
          }
        }
      ],
      "filters": {
        "text_rule": "all"
      },
      "handlers": [
        {
          "handler": "relay_message",
          "params": {
            "ignore_self": true,
            "targets": [
              {
                "chat_id": "@ARCHIVE_CHANNEL",
                "mode": "forward",
                "dedup": "message"
              },
              {
                "chat_id": "@SECOND_BACKUP",
                "mode": "copy",
                "dedup": "message"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "extract_any_urls_to_bot",
      "enabled": false,
      "triggers": [
        {
          "type": "message",
          "params": {
            "chat_ids": [
              "@SOURCE_CHANNEL_A"
            ]
          }
        }
      ],
      "filters": {
        "text_rule": "regex",
        "text_value": "https?://[^\\s]+",
        "ignore_case": true
      },
      "handlers": [
        {
          "handler": "relay_message",
          "params": {
            "targets": [
              {
                "chat_id": "@YOUR_PROCESSING_BOT",
                "mode": "extract",
                "pattern": "(https?://[^\\s]+)",
                "group": 1,
                "all_matches": true,
                "dedup": "content"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "keyword_to_notification",
      "enabled": false,
      "triggers": [
        {
          "type": "message",
          "params": {
            "chat_id": "@SOURCE_GROUP_B"
          }
        }
      ],
      "filters": {
        "text_rule": "contains",
        "text_value": "NOTICE",
        "ignore_case": true
      },
      "handlers": [
        {
          "handler": "relay_message",
          "params": {
            "targets": [
              {
                "chat_id": "@PRIVATE_NOTIFICATION",
                "mode": "template",
                "template": "Source {chat_id}, message #{message_id}\n{text}",
                "dedup": "message"
              }
            ]
          }
        }
      ]
    }
  ]
}
